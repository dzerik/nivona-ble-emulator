# Seeed XIAO ESP32-S3 — Xtensa LX7, 8 MB flash, 8 MB OPI PSRAM, USB Serial/JTAG.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/xiao_s3/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="boards/xiao_s3/partitions.csv"

# Octal PSRAM on XIAO S3.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Headless board — no display/UI.
CONFIG_NIVONA_BOARD_HAS_DISPLAY=n
