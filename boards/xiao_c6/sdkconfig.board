# XIAO ESP32-C6 — ESP32-C6 RISC-V, 4 MB flash, onboard/U.FL antenna via RF switch.
CONFIG_IDF_TARGET="esp32c6"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/xiao_c6/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="boards/xiao_c6/partitions.csv"

# Headless board — no display/UI.
CONFIG_NIVONA_BOARD_HAS_DISPLAY=n
